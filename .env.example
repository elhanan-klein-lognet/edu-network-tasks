# Copy this file to .env.local for local development.
# In Vercel, set these under Project Settings → Environment Variables,
# scoped separately per Environment (Production / Preview) — see README.md
# and spec.md section 9 ("סביבות עבודה: Dev/Test מול Production").

# Supabase project settings (Project Settings → API in the Supabase dashboard).
# Use the PRODUCTION project's values for Vercel's Production environment,
# and the DEV/TEST project's values for Vercel's Preview environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only, never exposed to the browser (no
# NEXT_PUBLIC_ prefix). Used by admin-panel server actions to invite users
# etc. Keep this out of the client bundle at all costs.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (spec.md section 9) — used both as Supabase Auth's
# custom SMTP (invite emails) and called directly from the Vercel Cron Job
# (due-date / overdue notifications, section 8).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shared secret Vercel Cron sends so /api/cron/* routes can verify the
# request actually came from Vercel's scheduler, not a public caller.
CRON_SECRET=
